# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real secrets.

# --- App ---
# ENV=development
# LOG_LEVEL=INFO

# --- Google Vertex AI ---
# Your GCP project ID (Vertex AI usage is billed to this project)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_REGION=us-central1

# --- Neo4j ---
# Password for the local Neo4j container (user is always "neo4j").
# Keep this in sync with docker-compose.yml's fallback if left unset.
NEO4J_PASSWORD=changeme-dev-password

# --- Qdrant ---
# Only needed if you've enabled auth on Qdrant (not required for local dev)
# QDRANT_API_KEY=